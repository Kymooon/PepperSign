# ==========================================================
# PepperSign - configurazione Docker
# Copia questo file in ".env" (stessa cartella di docker-compose.yml)
# e modifica i valori per la tua rete. Il file .env non va su Git.
# ==========================================================

# --- Rete ---
# IP del robot Pepper (lo dice Pepper premendo il pulsante sul petto)
PEPPER_IP=192.168.137.141
PEPPER_PORT=9559

# IP di QUESTO computer, visto dal tablet di Pepper / dagli altri dispositivi.
# E' l'indirizzo per cui viene emesso il certificato HTTPS.
# Esempio con hotspot di Windows: 192.168.137.1
PEPPERSIGN_HOST=192.168.137.1

# --- Porte esposte sul computer ---
HTTPS_PORT=8443
WEB_HTTP_PORT=8080
CONTROLL_GUI_PORT=6080

# --- Cartelle dati (sul computer) ---
# Video/immagini degli scheletri, condivise tra Web e Process.
# Per riusare i dati gia' generati: PEPPERSIGN_MEDIA_DIR=C:/Users/<utente>/PepperSignData
PEPPERSIGN_MEDIA_DIR=./data/media
# Gesture JSON registrate con la GUI di Controll.
# Per riusare quelle esistenti: PEPPERSIGN_GESTURES_DIR=C:/Users/<utente>/PepperSignGestures
PEPPERSIGN_GESTURES_DIR=./data/gestures

# --- Process ---
# Modello Whisper: tiny | base | small | medium (piu' grande = piu' preciso e lento)
ASR_MODEL=base
GPU_CONCURRENCY=1
ASR_CONCURRENCY=1
TRY_SCORE_THRESHOLD=0.65
TRY_TTL_SECONDS=900

# --- Controll ---
PEPPER_TTS_LANGUAGE=Italian
# Modalita' demo senza robot: 1 = Pepper simulato (i comandi vengono solo
# mostrati nella GUI su :6080), 0 = robot reale all'indirizzo PEPPER_IP
PEPPERSIGN_FAKE_ROBOT=0
# Movimenti autonomi durante l'esecuzione dei gesti (Autonomous Life resta attiva):
#   pause = pausa solo di respiro/movimenti delle braccia (+ testa se il gesto la usa)
#   off   = pausa di tutti i movimenti autonomi durante il gesto
#   none  = nessun intervento (comportamento precedente)
PEPPERSIGN_GESTURE_AUTONOMY=pause
# Attese (secondi) prima e dopo ogni gesto, con i movimenti autonomi in pausa:
# prima = tempo perche' si fermino e le braccia si irrigidiscano; dopo = posa finale tenuta
PEPPERSIGN_GESTURE_PRE_DELAY=0.8
PEPPERSIGN_GESTURE_POST_DELAY=0.6
# Dimensioni del desktop virtuale della GUI (larghezza x altezza x colori)
# e della finestra del controller. Se lo schermo e' piu' piccolo, in noVNC
# usa Impostazioni -> Ridimensionamento locale.
CONTROLL_SCREEN=1920x1080x24
CONTROLL_WINDOW_SIZE=1900x1040
# Password per la GUI via browser (vuota = nessuna password)
VNC_PASSWORD=
